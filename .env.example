# App Environment
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Authentication & Security
# REQUIRED in production (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development an unset secret falls back to a random per-process one (sessions reset on restart).
JWT_SECRET=""
SESSION_EXPIRY_DAYS=7

# Seed accounts. In production, unset values mean a random password is generated and printed once in the log.
# SEED_ADMIN_PASSWORD=""
# SEED_STUDENT_PASSWORD=""

# Number of reverse proxies in front of the app (1 on most hosts). Needed for correct client IPs / rate limiting.
# TRUST_PROXY=1

# Database Configuration (SQLite local or PostgreSQL URL for managed deployments)
DATABASE_PATH="./data/cyberosh_pariksha.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/cyberosh_pariksha"

# Storage Configuration (Local sandbox or S3-compatible private object storage)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
# S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
# S3_BUCKET="cyberosh-pariksha-storage"
# S3_ACCESS_KEY_ID="your_access_key"
# S3_SECRET_ACCESS_KEY="your_secret_key"

# Payment Gateway (Razorpay)
# Leave these empty in development to use the simulated sandbox checkout.
# In production, empty/demo keys DISABLE payments; real keys enable live checkout with strict signature checks.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email & Notifications (SMTP / Postmark / SendGrid)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="sandbox_user"
SMTP_PASS="sandbox_pass"
EMAIL_FROM="no-reply@cyberoshpariksha.in"

# Monitoring & Analytics (Optional Sentry & PostHog)
# SENTRY_DSN=""
# POSTHOG_API_KEY=""

