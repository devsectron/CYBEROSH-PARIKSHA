rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'devsectron@gmail.com' ||
        request.auth.token.email == 'admin@cyberoshpariksha.in'
      );
    }

    function isAdmin() {
      return isOwnerEmail() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // A user may create their own profile as a student (owner emails excepted) and may never change its role.
      allow create: if (isOwner(userId) && (request.resource.data.get('role', 'student') == 'student' || isOwnerEmail())) || isAdmin();
      allow update: if (isOwner(userId) && request.resource.data.get('role', null) == resource.data.get('role', null)) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Public Catalog: Exam Categories
    match /exam_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Catalog: Examinations
    match /examinations/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Questions Bank
    match /questions/{questionId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    // Mock Tests
    match /mock_tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Test Attempts
    match /test_attempts/{attemptId} {
      allow read: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();

      // Student answers subcollection
      match /student_answers/{answerId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/test_attempts/$(attemptId)).data.user_id == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Study Materials
    match /study_materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Model Papers
    match /model_papers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subscription Plans
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      // Payments are written only by the server (Admin SDK bypasses rules) or an admin; a client must never
      // be able to mark its own payment as successful.
      allow read: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Entitlements
    match /entitlements/{entitlementId} {
      // Entitlements grant paid access, so clients can read their own but never write them.
      allow read: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Current Affairs
    match /current_affairs/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookmarks
    match /bookmarks/{bookmarkId} {
      allow read, delete: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid;
    }

    // Test Connection probe
    match /test/connection {
      allow read: if true;
    }
  }
}
